# ENTSO-E Transparency Platform token (request API access through their official process).
ENTSOE_API_TOKEN=

# Open-Meteo historical observations (Madrid coordinates, UTC timestamps).
WEATHER_LATITUDE=40.4168
WEATHER_LONGITUDE=-3.7038
WEATHER_TIMEZONE=UTC

# Local PostgreSQL connection (used by the loaders and report generator).
POSTGRES_DB=energy
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy_local_only
DATABASE_URL=postgresql://energy:energy_local_only@localhost:5433/energy

# Raw response landing zone, relative to project root.
RAW_DATA_DIR=data/raw
